# ============================================================
# MUNDIAL PREDICTOR — Variables de Entorno
# ============================================================
# Copia este archivo como .env.local y completa los valores.
# NUNCA subas .env.local a control de versiones.
# ============================================================

# --- Supabase ---
# Obtén estos valores en: https://supabase.com/dashboard → tu proyecto → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- football-data.org ---
# Regístrate en: https://www.football-data.org/client/register
# El plan gratuito es suficiente para la beta privada.
FOOTBALL_DATA_API_TOKEN=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4
# Código de la competición del Mundial FIFA 2026
FOOTBALL_DATA_COMPETITION_CODE=WC

# --- Seguridad de Cron Jobs ---
# Genera un string aleatorio seguro, ej: openssl rand -hex 32
# Este valor protege los endpoints /api/cron/* para usarlos con cron-job.org
CRON_SECRET=

# --- App ---
APP_URL=http://localhost:3000
