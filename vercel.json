{
  "crons": [
    {
      "path": "/api/cron/sync-fixtures",
      "schedule": "0 2 * * *",
      "comment": "Sync complete fixture once per day at 02:00 UTC"
    }
  ],
  "headers": [
    {
      "source": "/api/cron/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
